# Postgres
POSTGRES_DB=hackathon
POSTGRES_USER=hackathon
POSTGRES_PASSWORD=hackathon
# Host port for postgres (change if 5432 is already in use locally)
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgres://hackathon:hackathon@postgres:5432/hackathon
BACKEND_PORT=4000
JWT_SECRET=dev-insecure-secret-change-me

# Photo storage (S3 only). Local dev uses the bundled MinIO service.
S3_BUCKET=bahandi-photos
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://minio:9000
# MinIO root credentials are reused as the S3 access keys in compose
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Frontend / Mobile (Flutter web)
VITE_API_BASE_URL=http://localhost:4000
MOBILE_API_BASE_URL=http://localhost:4000
MOBILE_PORT=8080

# AI photo analysis (optional)
ANTHROPIC_API_KEY=

# iiko Server API (on-prem write-off act creation; акт списания)
# password must be the SHA1 hash of the iiko user password
IIKO_SERVER_BASE_URL=
IIKO_SERVER_LOGIN=
IIKO_SERVER_PASSWORD_SHA1=
IIKO_SERVER_STORE_ID=
IIKO_SERVER_ACCOUNT_ID=
